{
  "name": "integratec-final-back",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm --recursive run build",
    "test": "pnpm --recursive run test",
    "typecheck": "pnpm --recursive run typecheck",
    "prisma:generate": "pnpm --filter @aula/api prisma:generate",
    "prisma:migrate:dev": "pnpm --filter @aula/api prisma:migrate:dev",
    "prisma:migrate:deploy": "pnpm --filter @aula/api prisma:migrate:deploy",
    "prisma:seed": "pnpm --filter @aula/api prisma:seed",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "openapi:export": "pnpm --filter @aula/api openapi:export",
    "realtime:codegen": "pnpm --filter @aula/realtime codegen && prettier --write packages/contracts/src/realtime/generated",
    "realtime:codegen:check": "pnpm realtime:codegen && git diff --exit-code -- packages/contracts/src/realtime/generated"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.4",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "eslint": "^9.20.1",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1",
    "vitest": "^3.0.5"
  }
}
