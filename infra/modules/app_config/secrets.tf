# Terraform creates only the empty secret containers. The values are generated by AWS
# (get-random-password) and loaded once by infra/scripts/seed-app-secrets.sh, never by
# Terraform, so they cannot reach the configuration, plan, outputs or state.
locals {
  # One entry per secret, keyed by the env var it feeds. `services` says
  # which containers may receive it (the instance role policy follows this map).
  secrets = {
    INTERNAL_SERVICE_SECRET = {
      description = "Shared secret for api to realtime internal calls (min 32 characters)."
      services    = ["api", "realtime"]
    }
    JWT_SECRET = {
      description = "Signing secret for API access tokens (min 32 characters)."
      services    = ["api"]
    }
    INVITATION_TOKEN_KEY = {
      description = "32-byte invitation token key as 64 lowercase hex characters (decodeKey32 in api-config.ts)."
      services    = ["api"]
    }
  }
}

resource "aws_secretsmanager_secret" "this" {
  for_each = local.secrets

  name                    = "${var.name_prefix}/${lower(replace(each.key, "_", "-"))}"
  description             = each.value.description
  recovery_window_in_days = var.secret_recovery_window_in_days

  tags = {
    Name = "${var.name_prefix}/${lower(replace(each.key, "_", "-"))}"
  }
}
