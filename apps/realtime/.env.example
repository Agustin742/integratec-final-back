# Copy to .env and replace every placeholder. Never commit real values.
# See the "Configuration" section of the root README for each variable.

NODE_ENV=development
PORT=2567
API_INTERNAL_URL=http://localhost:3000

# Must equal the API's INTERNAL_SERVICE_SECRET. The placeholder is intentionally
# shorter than the 32-character minimum so the server refuses to start until it
# is replaced. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_SERVICE_SECRET=replace-with-generated-secret

# Seconds a dropped connection may reconnect before its avatar is removed (1-120).
RECONNECTION_WINDOW_SECONDS=20
