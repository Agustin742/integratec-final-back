generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SchoolRole {
  OWNER   @map("owner")
  ADMIN   @map("admin")
  TEACHER @map("teacher")

  @@map("school_role")
}

enum MembershipState {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")

  @@map("membership_state")
}

enum ClassroomRole {
  TEACHER @map("teacher")
  STUDENT @map("student")

  @@map("classroom_role")
}

enum InvitationKind {
  EMAIL     @map("email")
  JOIN_CODE @map("join_code")

  @@map("invitation_kind")
}

enum InvitationRole {
  OWNER   @map("owner")
  ADMIN   @map("admin")
  TEACHER @map("teacher")
  STUDENT @map("student")

  @@map("invitation_role")
}

enum InvitationState {
  PENDING @map("pending")
  USED    @map("used")
  REVOKED @map("revoked")
  EXPIRED @map("expired")

  @@map("invitation_state")
}

enum RegistrationPath {
  INDEPENDENT_TEACHER @map("independent_teacher")
  SCHOOL              @map("school")

  @@map("registration_path")
}

enum PointEntryKind {
  EARNING      @map("earning")
  DEBIT        @map("debit")
  COMPENSATION @map("compensation")

  @@map("point_entry_kind")
}

enum ActivityType {
  TP   @map("tp")
  EXAM @map("exam")

  @@map("activity_type")
}

enum ActivityFormat {
  FILE            @map("file")
  MULTIPLE_CHOICE @map("multiple_choice")

  @@map("activity_format")
}

enum ActivityState {
  DRAFT     @map("draft")
  PUBLISHED @map("published")

  @@map("activity_state")
}

enum ShopItemKind {
  CLASSROOM_ITEM   @map("classroom_item")
  AVATAR_ACCESSORY @map("avatar_accessory")
  DESK_UPGRADE     @map("desk_upgrade")
  PET_ACCESSORY    @map("pet_accessory")

  @@map("shop_item_kind")
}

enum ClassroomItemState {
  UNLOCKED @map("unlocked")
  ACTIVE   @map("active")
  DISABLED @map("disabled")

  @@map("classroom_item_state")
}

/// Equipment slots derived from ShopItem.metadata.slot at equip time.
enum EquippedSlot {
  HEAD       @map("head")
  FACE       @map("face")
  BACK       @map("back")
  DESK_DECOR @map("desk_decor")

  @@map("equipped_slot")
}

model User {
  id                 String           @id @default(uuid()) @db.Uuid
  email              String           @unique @db.VarChar(255)
  passwordHash       String           @map("password_hash") @db.VarChar(255)
  displayName        String           @map("display_name") @db.VarChar(100)
  registrationPath   RegistrationPath @map("registration_path")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  appearanceRevision Int              @default(0) @map("appearance_revision")

  avatarConfig             AvatarConfiguration?
  sessions                 Session[]
  passwordResetTokens      PasswordResetToken[]
  schoolMemberships        SchoolMember[]
  independentClassrooms    Classroom[]           @relation("IndependentTeacherClassrooms")
  classroomMemberships     ClassroomMembership[]
  createdInvitations       Invitation[]          @relation("InvitationCreator")
  parentOfLinks            ParentLink[]          @relation("ParentLinks")
  childInLinks             ParentLink[]          @relation("ChildLinks")
  usedJoinCodes            JoinCodeUsage[]
  notifications            Notification[]        @relation("NotificationRecipient")
  studentNotifications     Notification[]        @relation("NotificationStudent")
  activityMetrics          ActivityMetric[]
  studentPointTransactions PointTransaction[]    @relation("StudentPointTransactions")
  actorPointTransactions   PointTransaction[]    @relation("ActorPointTransactions")
  studentPurchases         StudentPurchase[]     @relation("StudentPurchases")
  createdActivities        Activity[]
  authoredStudyMaterials   StudyMaterial[]       @relation("MaterialAuthor")
  removedStudyMaterials    StudyMaterial[]       @relation("MaterialRemover")
  forumThreads             ActivityForumThread[] @relation("ActivityForumThreadAuthor")
  forumPosts               ActivityForumPost[]   @relation("ActivityForumPostAuthor")
  equippedItems            EquippedItem[]
  submissions              Submission[]
  gradedGrades             Grade[]               @relation("GradedGrades")
  gradeRevisions           GradeRevision[]       @relation("GradedGradeRevisions")
  authoredAnnouncements    Announcement[]        @relation("AnnouncementAuthor")
  mentions                 Mention[]             @relation("MentionedUsers")
  authoredMessages         Message[]             @relation("MessageAuthor")
  hiddenMessages           Message[]             @relation("MessageModerator")
  streak                   Streak?               @relation("StudentStreak")
  streakQualifyingDays     StreakQualifyingDay[] @relation("StudentStreakQualifyingDays")
  badges                   StudentBadge[]        @relation("StudentBadges")

  @@map("users")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// One row per refresh token ever issued for a session. Only the SHA-256 hex digest
/// is stored. Rotation marks the old row with rotatedAt instead of deleting it, so
/// reuse of a rotated token stays detectable and can revoke the whole session.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(6)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([rotatedAt])
  @@map("refresh_tokens")
}

/// Single-use password reset tokens. Only the SHA-256 hex digest of the opaque token
/// is stored; the raw value exists only in the emailed link. `sourceEventId` ties a
/// row to the outbox event that requested it, so redelivering the event is idempotent,
/// and `sentAt` records that the email went out.
model PasswordResetToken {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  sourceEventId String?   @unique @map("source_event_id") @db.Uuid
  sentAt        DateTime? @map("sent_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model AvatarConfiguration {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @map("user_id") @db.Uuid
  appearance Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("avatar_configurations")
}

model School {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(150)
  slug      String    @unique @db.VarChar(150)
  timeZone  String    @default("America/Argentina/Buenos_Aires") @map("time_zone") @db.VarChar(100)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  members     SchoolMember[]
  classrooms  Classroom[]
  invitations Invitation[]

  @@map("schools")
}

model SchoolMember {
  id        String          @id @default(uuid()) @db.Uuid
  schoolId  String          @map("school_id") @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  role      SchoolRole
  state     MembershipState @default(ACTIVE)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([schoolId, userId])
  @@index([schoolId])
  @@index([userId])
  @@map("school_members")
}

model Classroom {
  id                   String    @id @default(uuid()) @db.Uuid
  schoolId             String?   @map("school_id") @db.Uuid
  independentTeacherId String?   @map("independent_teacher_id") @db.Uuid
  name                 String    @db.VarChar(120)
  subject              String?   @db.VarChar(200)
  adultMode            Boolean   @default(false) @map("adult_mode")
  chatMuted            Boolean   @default(false) @map("chat_muted")
  collaborationLocked  Boolean   @default(false) @map("collaboration_locked")
  gamesDisabled        Boolean   @default(false) @map("games_disabled")
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  school              School?               @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  independentTeacher  User?                 @relation("IndependentTeacherClassrooms", fields: [independentTeacherId], references: [id], onDelete: Restrict)
  memberships         ClassroomMembership[]
  desks               Desk[]
  pet                 ClassroomPet?
  invitations         Invitation[]
  parentLinks         ParentLink[]
  notifications       Notification[]
  activityMetrics     ActivityMetric[]
  pointTransactions   PointTransaction[]
  shopItemOverrides   ClassroomShopItem[]
  classroomItems      ClassroomItem[]
  studentPurchases    StudentPurchase[]
  activities          Activity[]
  announcements       Announcement[]
  messages            Message[]
  studyMaterials      StudyMaterial[]
  equippedItems       EquippedItem[]
  botConfig           BotConfig?
  botAllowedMaterials AllowedMaterial[]

  @@index([schoolId])
  @@index([independentTeacherId])
  @@map("classrooms")
}

/// Private classroom files. Logical removal keeps author/history and the private object.
model StudyMaterial {
  id          String    @id @default(uuid()) @db.Uuid
  classroomId String    @map("classroom_id") @db.Uuid
  authorId    String    @map("author_id") @db.Uuid
  objectKey   String    @unique @map("object_key") @db.VarChar(255)
  filename    String    @db.VarChar(120)
  contentType String    @map("content_type") @db.VarChar(32)
  sizeBytes   Int       @map("size_bytes")
  removedAt   DateTime? @map("removed_at") @db.Timestamptz(6)
  removedById String?   @map("removed_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  classroom     Classroom         @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  author        User              @relation("MaterialAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  removedBy     User?             @relation("MaterialRemover", fields: [removedById], references: [id], onDelete: Restrict)
  botAllowances AllowedMaterial[]

  @@index([classroomId, removedAt, createdAt, id])
  @@index([authorId])
  @@index([removedById])
  @@map("study_materials")
}

model ClassroomMembership {
  id          String          @id @default(uuid()) @db.Uuid
  classroomId String          @map("classroom_id") @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  role        ClassroomRole   @default(STUDENT)
  state       MembershipState @default(ACTIVE)
  deletedAt   DateTime?       @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  desk      Desk?

  @@unique([classroomId, userId])
  @@index([classroomId])
  @@index([userId])
  @@map("classroom_memberships")
}

model Desk {
  id           String   @id @default(uuid()) @db.Uuid
  classroomId  String   @map("classroom_id") @db.Uuid
  membershipId String?  @unique @map("membership_id") @db.Uuid
  deskIndex    Int      @map("desk_index")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  classroom  Classroom            @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  membership ClassroomMembership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  @@unique([classroomId, deskIndex])
  @@index([classroomId])
  @@map("desks")
}

model ClassroomPet {
  id          String   @id @default(uuid()) @db.Uuid
  classroomId String   @unique @map("classroom_id") @db.Uuid
  name        String   @db.VarChar(50)
  species     String   @default("cat") @db.VarChar(50)
  level       Int      @default(1)
  experience  Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Restrict)

  @@map("classroom_pets")
}

model ParentLink {
  id          String          @id @default(uuid()) @db.Uuid
  parentId    String          @map("parent_id") @db.Uuid
  childId     String          @map("child_id") @db.Uuid
  classroomId String          @map("classroom_id") @db.Uuid
  state       MembershipState @default(ACTIVE)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent    User      @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Restrict)
  child     User      @relation("ChildLinks", fields: [childId], references: [id], onDelete: Restrict)
  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Restrict)

  messages Message[]

  @@unique([parentId, childId, classroomId])
  @@index([parentId])
  @@index([childId])
  @@index([classroomId])
  @@map("parent_links")
}

model Invitation {
  id          String          @id @default(uuid()) @db.Uuid
  kind        InvitationKind  @default(EMAIL)
  secretHash  String          @unique @map("secret_hash") @db.VarChar(255)
  targetEmail String?         @map("target_email") @db.VarChar(255)
  schoolId    String?         @map("school_id") @db.Uuid
  classroomId String?         @map("classroom_id") @db.Uuid
  role        InvitationRole  @default(STUDENT)
  maxUses     Int?            @map("max_uses")
  useCount    Int             @default(0) @map("use_count")
  expiresAt   DateTime        @map("expires_at") @db.Timestamptz(6)
  state       InvitationState @default(PENDING)
  createdById String          @map("created_by_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  school    School?         @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  classroom Classroom?      @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  createdBy User            @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  usages    JoinCodeUsage[]

  @@index([schoolId])
  @@index([classroomId])
  @@index([createdById])
  @@index([targetEmail])
  @@map("invitations")
}

/// Aggregated activity signals per user and classroom, one row per UTC day. Connected time is
/// reported by the realtime server as an aggregate (never per tick or per movement) and added to
/// the row of the day the presence session ended. Submissions and participation join this row
/// with the activity-level metric (issue #36).
model ActivityMetric {
  id               String   @id @default(uuid()) @db.Uuid
  classroomId      String   @map("classroom_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  day              DateTime @db.Date
  connectedSeconds Int      @default(0) @map("connected_seconds")
  /// Raw counts (gap 17 keeps the composite formula open): submissions created that day, and
  /// classroom-channel participation (chat messages sent, RF-COM-002).
  submissionCount  Int      @default(0) @map("submission_count")
  messageCount     Int      @default(0) @map("message_count")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([classroomId, userId, day])
  @@index([userId])
  @@map("activity_metrics")
}

/// Academic activity (TP or exam) published by a teacher to a classroom. It is unrelated to
/// ActivityMetric, which aggregates connected time. Deletion is always logical (`deletedAt`).
/// Invariants enforced by CHECK constraints in the database (and validated again in the service):
/// `maxScore` 0-100, `weightMultiplier` 0.5-3, `opensAt` (when set) strictly before `dueAt`, and
/// `publishedAt` required whenever `state` is PUBLISHED. Instants are UTC.
model Activity {
  id               String         @id @default(uuid()) @db.Uuid
  classroomId      String         @map("classroom_id") @db.Uuid
  createdById      String         @map("created_by_id") @db.Uuid
  type             ActivityType
  format           ActivityFormat
  state            ActivityState  @default(DRAFT)
  title            String         @db.VarChar(120)
  description      String         @default("")
  opensAt          DateTime?      @map("opens_at") @db.Timestamptz(6)
  dueAt            DateTime       @map("due_at") @db.Timestamptz(6)
  allowLate        Boolean        @default(false) @map("allow_late")
  maxScore         Int            @map("max_score")
  weightMultiplier Decimal        @default(1) @map("weight_multiplier") @db.Decimal(3, 2)
  publishedAt      DateTime?      @map("published_at") @db.Timestamptz(6)
  deletedAt        DateTime?      @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  classroom    Classroom             @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  createdBy    User                  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  questions    Question[]
  forumThreads ActivityForumThread[]
  submissions  Submission[]

  @@index([classroomId, state, deletedAt])
  @@index([classroomId, dueAt, id])
  @@index([createdById])
  @@map("activities")
}

model Question {
  id         String   @id @default(uuid()) @db.Uuid
  activityId String   @map("activity_id") @db.Uuid
  position   Int
  prompt     String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  activity Activity           @relation(fields: [activityId], references: [id], onDelete: Restrict)
  options  Option[]
  answers  SubmissionAnswer[]

  @@unique([activityId, position])
  @@map("questions")
}

/// `isCorrect` is server-side only and must never be selected for student responses.
model Option {
  id         String  @id @default(uuid()) @db.Uuid
  questionId String  @map("question_id") @db.Uuid
  position   Int
  label      String
  isCorrect  Boolean @default(false) @map("is_correct")

  question Question           @relation(fields: [questionId], references: [id], onDelete: Restrict)
  answers  SubmissionAnswer[]

  @@unique([questionId, position])
  @@map("options")
}

/// Per-activity query forum (HU-COM-003, MVP Core). A thread is scoped to exactly one
/// Activity and holds an ordered list of posts; the first post is the original question.
/// It does NOT share the `Message` entity: that entity is pinned by `rules/data.md` to
/// exactly one context (classroom channel or parent conversation), enforced in the
/// database, and no Message table exists yet. Retention and content filtering are open
/// decisions recorded in issue #39 (gap 7); no edit or moderation endpoints in this card.
model ActivityForumThread {
  id         String   @id @default(uuid()) @db.Uuid
  activityId String   @map("activity_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  activity Activity            @relation(fields: [activityId], references: [id], onDelete: Restrict)
  author   User                @relation("ActivityForumThreadAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  posts    ActivityForumPost[]

  @@index([activityId, createdAt, id])
  @@index([authorId])
  @@map("activity_forum_threads")
}

/// One post inside an activity forum thread. The server sets author and timestamp and
/// clients MUST NOT. Bodies are validated server-side (non-empty after trim, bounded),
/// stored and returned as plain text, never interpreted or rendered as HTML, and are
/// never logged (see rules/observability-and-privacy.md).
model ActivityForumPost {
  id        String   @id @default(uuid()) @db.Uuid
  threadId  String   @map("thread_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String   @db.VarChar(2000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  thread ActivityForumThread @relation(fields: [threadId], references: [id], onDelete: Restrict)
  author User                @relation("ActivityForumPostAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([threadId, createdAt, id])
  @@index([authorId])
  @@map("activity_forum_posts")
}

/// A student's single submission to a FILE activity (MVP: no resubmission). `submittedAt` is
/// always set by the server; `isLate` is true when it passed `dueAt` on an `allowLate` activity.
/// `idempotencyKey` is the client's `Idempotency-Key`. CHECK constraints in the database: key
/// length 1-255 (see the create_submissions migration). `autoScore` is the server-computed
/// score of a MULTIPLE_CHOICE submission (0..`maxScore`, decided inside the submit transaction);
/// FILE submissions keep it null and are graded by a teacher through `Grade`.
model Submission {
  id             String   @id @default(uuid()) @db.Uuid
  activityId     String   @map("activity_id") @db.Uuid
  studentId      String   @map("student_id") @db.Uuid
  submittedAt    DateTime @map("submitted_at") @db.Timestamptz(6)
  isLate         Boolean  @default(false) @map("is_late")
  autoScore      Int?     @map("auto_score")
  idempotencyKey String   @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  activity Activity           @relation(fields: [activityId], references: [id], onDelete: Restrict)
  student  User               @relation(fields: [studentId], references: [id], onDelete: Restrict)
  files    SubmissionFile[]
  answers  SubmissionAnswer[]
  grade    Grade?

  @@unique([activityId, studentId])
  @@index([studentId])
  @@map("submissions")
}

/// One stored file of a submission. Bytes live in private object storage under `storageKey`.
/// CHECK constraints in the database: `sizeBytes` 1 byte-10 MB, `position` 0-4 (at most five
/// files), `originalName` length 1-255 and `contentType` limited to the allow-list.
model SubmissionFile {
  id           String   @id @default(uuid()) @db.Uuid
  submissionId String   @map("submission_id") @db.Uuid
  storageKey   String   @unique @map("storage_key")
  originalName String   @map("original_name")
  contentType  String   @map("content_type")
  sizeBytes    Int      @map("size_bytes")
  position     Int
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Restrict)

  @@unique([submissionId, position])
  @@map("submission_files")
}

/// One chosen option per question of a MULTIPLE_CHOICE submission. Written once inside the
/// submit transaction together with the computed `Submission.autoScore`; never updated.
/// CHECK constraints in the database: one answer per question and `position` 0-99 (see the
/// add_mc_submission_answers migration).
model SubmissionAnswer {
  id           String   @id @default(uuid()) @db.Uuid
  submissionId String   @map("submission_id") @db.Uuid
  questionId   String   @map("question_id") @db.Uuid
  optionId     String   @map("option_id") @db.Uuid
  position     Int
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Restrict)
  option     Option     @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@unique([submissionId, questionId])
  @@unique([submissionId, position])
  @@index([questionId])
  @@map("submission_answers")
}

/// Transactional outbox: written in the same transaction as the business change and
/// delivered at-least-once to in-process handlers after commit. Rows are never deleted
/// here; `processedAt` marks delivery and `failedAt` marks exhausted retries.
model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  type        String    @db.VarChar(100)
  payload     Json
  occurredAt  DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  failedAt    DateTime? @map("failed_at") @db.Timestamptz(6)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error") @db.VarChar(300)

  notification Notification?

  @@index([processedAt, failedAt, availableAt])
  @@map("outbox_events")
}

model JoinCodeUsage {
  id           String   @id @default(uuid()) @db.Uuid
  invitationId String   @map("invitation_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  usedAt       DateTime @default(now()) @map("used_at") @db.Timestamptz(6)

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([invitationId, userId])
  @@index([invitationId])
  @@index([userId])
  @@map("join_code_usages")
}

/// Minimal navigation metadata, never source content or grades.
model Notification {
  id            String    @id @default(uuid()) @db.Uuid
  recipientId   String    @map("recipient_id") @db.Uuid
  classroomId   String?   @map("classroom_id") @db.Uuid
  studentId     String?   @map("student_id") @db.Uuid
  sourceEventId String    @unique @map("source_event_id") @db.Uuid
  kind          String    @db.VarChar(32)
  resourceId    String    @map("resource_id") @db.Uuid
  readAt        DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  recipient   User                   @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  classroom   Classroom?             @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  student     User?                  @relation("NotificationStudent", fields: [studentId], references: [id], onDelete: Restrict)
  sourceEvent OutboxEvent            @relation(fields: [sourceEventId], references: [id], onDelete: Restrict)
  deliveries  NotificationDelivery[]

  @@index([recipientId, createdAt, id])
  @@index([classroomId])
  @@index([studentId])
  @@map("notifications")
}

model NotificationDelivery {
  id             String    @id @default(uuid()) @db.Uuid
  notificationId String    @map("notification_id") @db.Uuid
  channel        String    @db.VarChar(20)
  deliveredAt    DateTime? @map("delivered_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Restrict)

  @@unique([notificationId, channel])
  @@map("notification_deliveries")
}

/// Immutable append-only points ledger per student and classroom.
/// Balance is derived as SUM(amount); entries are never updated or deleted.
model PointTransaction {
  id             String         @id @default(uuid()) @db.Uuid
  classroomId    String         @map("classroom_id") @db.Uuid
  studentId      String         @map("student_id") @db.Uuid
  actorId        String?        @map("actor_id") @db.Uuid
  entryKind      PointEntryKind @map("entry_kind")
  amount         Int
  sourceType     String         @map("source_type") @db.VarChar(40)
  sourceId       String         @map("source_id") @db.Uuid
  idempotencyKey String?        @unique @map("idempotency_key") @db.VarChar(128)
  reason         String         @db.VarChar(240)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  classroom       Classroom        @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  student         User             @relation("StudentPointTransactions", fields: [studentId], references: [id], onDelete: Restrict)
  actor           User?            @relation("ActorPointTransactions", fields: [actorId], references: [id], onDelete: Restrict)
  studentPurchase StudentPurchase?
  grade           Grade?
  gradeRevision   GradeRevision?

  @@index([classroomId, studentId, createdAt, id])
  @@index([studentId])
  @@map("point_transactions")
}

/// Server-owned catalog of purchasable shop items.
/// Items with `isImplemented = false` cannot be purchased.
model ShopItem {
  id            String       @id @default(uuid()) @db.Uuid
  code          String       @unique @db.VarChar(80)
  name          String       @db.VarChar(120)
  description   String       @default("")
  kind          ShopItemKind
  defaultPrice  Int          @map("default_price")
  isActive      Boolean      @default(true) @map("is_active")
  isImplemented Boolean      @default(false) @map("is_implemented")
  metadata      Json         @default("{}")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  classroomOverrides ClassroomShopItem[]
  classroomItems     ClassroomItem[]
  purchases          StudentPurchase[]
  equippedItems      EquippedItem[]

  @@index([kind, isActive])
  @@index([defaultPrice, id])
  @@map("shop_items")
}

/// Optional per-classroom price and availability overrides for a catalog shop item.
model ClassroomShopItem {
  id            String   @id @default(uuid()) @db.Uuid
  classroomId   String   @map("classroom_id") @db.Uuid
  shopItemId    String   @map("shop_item_id") @db.Uuid
  priceOverride Int?     @map("price_override")
  isEnabled     Boolean  @default(true) @map("is_enabled")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  shopItem  ShopItem  @relation(fields: [shopItemId], references: [id], onDelete: Restrict)

  @@unique([classroomId, shopItemId])
  @@index([shopItemId])
  @@map("classroom_shop_items")
}

/// Immutable record of a student shop purchase linked to its debit PointTransaction.
model StudentPurchase {
  id                 String   @id @default(uuid()) @db.Uuid
  classroomId        String   @map("classroom_id") @db.Uuid
  studentId          String   @map("student_id") @db.Uuid
  shopItemId         String   @map("shop_item_id") @db.Uuid
  pointTransactionId String   @unique @map("point_transaction_id") @db.Uuid
  pricePaid          Int      @map("price_paid")
  idempotencyKey     String   @map("idempotency_key") @db.VarChar(128)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  classroom        Classroom        @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  student          User             @relation("StudentPurchases", fields: [studentId], references: [id], onDelete: Restrict)
  shopItem         ShopItem         @relation(fields: [shopItemId], references: [id], onDelete: Restrict)
  pointTransaction PointTransaction @relation(fields: [pointTransactionId], references: [id], onDelete: Restrict)
  classroomItem    ClassroomItem?

  @@unique([classroomId, studentId, shopItemId])
  @@unique([classroomId, studentId, idempotencyKey])
  @@index([classroomId, studentId, createdAt, id])
  @@index([studentId])
  @@index([shopItemId])
  @@map("student_purchases")
}

/// Classroom-wide item unlocked by a student purchase.
model ClassroomItem {
  id          String             @id @default(uuid()) @db.Uuid
  classroomId String             @map("classroom_id") @db.Uuid
  shopItemId  String             @map("shop_item_id") @db.Uuid
  purchaseId  String             @unique @map("purchase_id") @db.Uuid
  state       ClassroomItemState @default(ACTIVE)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  classroom Classroom       @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  shopItem  ShopItem        @relation(fields: [shopItemId], references: [id], onDelete: Restrict)
  purchase  StudentPurchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  @@unique([classroomId, shopItemId])
  @@index([classroomId, state])
  @@index([shopItemId])
  @@map("classroom_items")
}

/// Server-owned grade for a submission (`score` 0-100) with optimistic concurrency `version`
/// and atomic link to the initial earning `PointTransaction` (nullable when `pointsAwarded = 0`).
model Grade {
  id                 String   @id @default(uuid()) @db.Uuid
  submissionId       String   @unique @map("submission_id") @db.Uuid
  graderId           String   @map("grader_id") @db.Uuid
  score              Int
  feedback           String
  /// Activity metadata frozen at grading time (same snapshot pattern as typeWeight and
  /// weightMultiplier): later activity edits never rewrite the values a student was graded
  /// against. A regrade refreshes both to the regrading-time values.
  activityTitle      String   @map("activity_title") @db.VarChar(120)
  maxScore           Int      @map("max_score")
  pointsAwarded      Int      @map("points_awarded")
  /// Weights used at the initial grade; regrades reuse them so later activity/config edits never move points.
  typeWeight         Decimal  @map("type_weight") @db.Decimal(4, 2)
  weightMultiplier   Decimal  @map("weight_multiplier") @db.Decimal(3, 2)
  pointTransactionId String?  @unique @map("point_transaction_id") @db.Uuid
  version            Int      @default(1)
  gradedAt           DateTime @map("graded_at") @db.Timestamptz(6)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  submission       Submission        @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  grader           User              @relation("GradedGrades", fields: [graderId], references: [id], onDelete: Restrict)
  pointTransaction PointTransaction? @relation(fields: [pointTransactionId], references: [id], onDelete: Restrict)
  revisions        GradeRevision[]

  @@index([graderId])
  @@map("grades")
}

/// Append-only history of initial grading (`version = 1`) and every regrade (`version >= 2`),
/// recording `pointsDelta` (the delta actually applied to the ledger), `pointsUnrecovered` (the part of a
/// downward delta the student's balance could not cover) and the linked earning/compensating
/// `PointTransaction` when points changed.
model GradeRevision {
  id                 String   @id @default(uuid()) @db.Uuid
  gradeId            String   @map("grade_id") @db.Uuid
  graderId           String   @map("grader_id") @db.Uuid
  version            Int
  score              Int
  feedback           String
  pointsDelta        Int      @map("points_delta")
  pointsUnrecovered  Int      @default(0) @map("points_unrecovered")
  pointTransactionId String?  @unique @map("point_transaction_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  grade            Grade             @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  grader           User              @relation("GradedGradeRevisions", fields: [graderId], references: [id], onDelete: Restrict)
  pointTransaction PointTransaction? @relation(fields: [pointTransactionId], references: [id], onDelete: Restrict)

  @@unique([gradeId, version])
  @@index([graderId])
  @@map("grade_revisions")
}

/// Bulletin-board notice owned by a classroom; removal is logical (`deletedAt`)
/// and announcements authored by users who later leave are preserved.
model Announcement {
  id          String    @id @default(uuid()) @db.Uuid
  classroomId String    @map("classroom_id") @db.Uuid
  authorId    String    @map("author_id") @db.Uuid
  title       String    @db.VarChar(200)
  content     String    @db.Text
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  author    User      @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([classroomId, deletedAt, createdAt, id])
  @@index([authorId])
  @@map("announcements")
}

/// Durable text in exactly one context; context/audit pairing checks live in SQL.
/// Membership deactivation never removes messages or their attribution.
model Message {
  id           String    @id @default(uuid()) @db.Uuid
  classroomId  String?   @map("classroom_id") @db.Uuid
  parentLinkId String?   @map("parent_link_id") @db.Uuid
  authorId     String    @map("author_id") @db.Uuid
  body         String    @db.Text
  hiddenAt     DateTime? @map("hidden_at") @db.Timestamptz(6)
  hiddenById   String?   @map("hidden_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  classroom  Classroom?  @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  parentLink ParentLink? @relation(fields: [parentLinkId], references: [id], onDelete: Restrict)
  author     User        @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  hiddenBy   User?       @relation("MessageModerator", fields: [hiddenById], references: [id], onDelete: Restrict)

  @@index([classroomId, createdAt, id])
  @@index([classroomId, authorId, createdAt, id])
  @@index([parentLinkId, createdAt, id])
  @@index([authorId])
  @@index([hiddenById])
  @@map("messages")
}

/// Resolved @ reference in a source resource (announcement or message).
/// The source follows the PointTransaction pattern (type + id columns without a
/// shared polymorphic foreign key); the mentioned user is a declared foreign key.
model Mention {
  id              String   @id @default(uuid()) @db.Uuid
  sourceType      String   @map("source_type") @db.VarChar(40)
  sourceId        String   @map("source_id") @db.Uuid
  mentionedUserId String   @map("mentioned_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  mentionedUser User @relation("MentionedUsers", fields: [mentionedUserId], references: [id], onDelete: Restrict)

  @@unique([sourceType, sourceId, mentionedUserId])
  @@index([mentionedUserId])
  @@map("mentions")
}

/// One equipped purchase per (classroom, student, slot). Classroom-scoped so an accessory
/// bought in one classroom never leaks into another; the desk decoration belongs to the
/// student's own desk in that classroom implicitly (the membership holds the desk).
model EquippedItem {
  id          String       @id @default(uuid()) @db.Uuid
  classroomId String       @map("classroom_id") @db.Uuid
  studentId   String       @map("student_id") @db.Uuid
  slot        EquippedSlot
  shopItemId  String       @map("shop_item_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  student   User      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  shopItem  ShopItem  @relation(fields: [shopItemId], references: [id], onDelete: Restrict)

  @@unique([classroomId, studentId, slot])
  @@index([shopItemId])
  @@map("equipped_items")
}

/// Real academic activity that may count as the day's streak milestone (RN-08).
enum StreakQualifyingSource {
  ON_TIME_SUBMISSION
  EXAM_PASSED
  DAILY_REVIEW_ANSWERED
}

/// Server-owned badge condition kinds. The medal catalog is open (gap 18); this
/// catalog ships as a test catalog and its entries may change until decided.
enum BadgeConditionType {
  STREAK_REACHED
  QUALIFYING_DAYS_REACHED
}

/// One row per student: current and best consecutive qualifying-day chains,
/// computed by the server in the fixed local day zone (RN-08). Never client-writable.
model Streak {
  id                     String   @id @default(uuid()) @db.Uuid
  studentId              String   @unique @map("student_id") @db.Uuid
  currentChainLength     Int      @default(0) @map("current_chain_length")
  bestChainLength        Int      @default(0) @map("best_chain_length")
  lastQualifyingLocalDay String?  @map("last_qualifying_local_day") @db.VarChar(10)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Derived gamification state of the student: it follows the user row
  // (explicit cascade, `rules/data.md` deletion policy); it never cascades
  // into user-generated content.
  student User @relation("StudentStreak", fields: [studentId], references: [id], onDelete: Cascade)

  @@map("streaks")
}

/// At most one milestone record per (student, local day); the unique constraint
/// makes concurrent qualifying actions count once (RN-08).
model StreakQualifyingDay {
  id        String                 @id @default(uuid()) @db.Uuid
  studentId String                 @map("student_id") @db.Uuid
  localDay  String                 @map("local_day") @db.VarChar(10)
  source    StreakQualifyingSource
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  // Derived gamification state of the student: it follows the user row (explicit cascade).
  student User @relation("StudentStreakQualifyingDays", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, localDay])
  @@map("streak_qualifying_days")
}

/// Server-owned badge catalog. The real medal catalog is an open decision; the
/// seed ships a small test catalog so the idempotent awarding mechanism is testable.
model BadgeDefinition {
  id            String             @id @default(uuid()) @db.Uuid
  code          String             @unique @db.VarChar(50)
  name          String             @db.VarChar(100)
  description   String             @db.VarChar(280)
  conditionType BadgeConditionType @map("condition_type")
  threshold     Int
  isActive      Boolean            @default(true) @map("is_active")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  badges StudentBadge[]

  @@map("badge_definitions")
}

/// Awarded once per (student, badge); repeated evaluation never duplicates the
/// badge or its notification (HU-GAM-002).
model StudentBadge {
  id                String   @id @default(uuid()) @db.Uuid
  studentId         String   @map("student_id") @db.Uuid
  badgeDefinitionId String   @map("badge_definition_id") @db.Uuid
  awardedAt         DateTime @default(now()) @map("awarded_at") @db.Timestamptz(6)

  // Derived gamification state of the student: it follows the user row (explicit cascade).
  // The catalog FK stays Restrict: removing a BadgeDefinition requires handling earned badges.
  student         User            @relation("StudentBadges", fields: [studentId], references: [id], onDelete: Cascade)
  badgeDefinition BadgeDefinition @relation(fields: [badgeDefinitionId], references: [id], onDelete: Restrict)

  @@unique([studentId, badgeDefinitionId])
  @@index([studentId, awardedAt])
  @@map("student_badges")
}

/// Lifecycle of a study material inside its classroom's bot index partition.
enum MaterialIndexState {
  PENDING @map("pending")
  INDEXED @map("indexed")
  FAILED  @map("failed")

  @@map("material_index_state")
}

/// Teacher's study-guide bot configuration for exactly one classroom (HU-BOT-001).
/// Created lazily when the first material is allowed for the bot; there is no bot
/// toggle or schedule in this configuration (rules/ai-bot-and-daily-briefing.md).
model BotConfig {
  id          String   @id @default(uuid()) @db.Uuid
  classroomId String   @unique @map("classroom_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  classroom        Classroom         @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  allowedMaterials AllowedMaterial[]

  @@map("bot_configs")
}

/// One study material the teacher allowed the classroom bot to use, unique per
/// (classroom, material) (rules/data.md). The explicit classroomId keeps the bot
/// index partition server-scoped, so retrieval can never cross classrooms or
/// schools; `failureReason` is set exactly while `indexState` is FAILED (CHECK).
model AllowedMaterial {
  id            String             @id @default(uuid()) @db.Uuid
  botConfigId   String             @map("bot_config_id") @db.Uuid
  classroomId   String             @map("classroom_id") @db.Uuid
  materialId    String             @map("material_id") @db.Uuid
  indexState    MaterialIndexState @default(PENDING) @map("index_state")
  /// Fixed, human-readable reason recorded when indexing fails; never the
  /// provider diagnostic (rules/error-handling-and-feedback.md).
  failureReason String?            @map("failure_reason") @db.VarChar(300)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  botConfig BotConfig     @relation(fields: [botConfigId], references: [id], onDelete: Cascade)
  classroom Classroom     @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  material  StudyMaterial @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@unique([classroomId, materialId])
  @@index([botConfigId, createdAt, id])
  @@index([materialId])
  @@map("allowed_materials")
}
