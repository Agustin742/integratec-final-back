generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SchoolRole {
  OWNER   @map("owner")
  ADMIN   @map("admin")
  TEACHER @map("teacher")

  @@map("school_role")
}

enum MembershipState {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")

  @@map("membership_state")
}

enum ClassroomRole {
  TEACHER @map("teacher")
  STUDENT @map("student")

  @@map("classroom_role")
}

enum InvitationKind {
  EMAIL     @map("email")
  JOIN_CODE @map("join_code")

  @@map("invitation_kind")
}

enum InvitationRole {
  OWNER   @map("owner")
  ADMIN   @map("admin")
  TEACHER @map("teacher")
  STUDENT @map("student")

  @@map("invitation_role")
}

enum InvitationState {
  PENDING @map("pending")
  USED    @map("used")
  REVOKED @map("revoked")
  EXPIRED @map("expired")

  @@map("invitation_state")
}

enum RegistrationPath {
  INDEPENDENT_TEACHER @map("independent_teacher")
  SCHOOL              @map("school")

  @@map("registration_path")
}

enum PointEntryKind {
  EARNING      @map("earning")
  DEBIT        @map("debit")
  COMPENSATION @map("compensation")

  @@map("point_entry_kind")
}

model User {
  id               String           @id @default(uuid()) @db.Uuid
  email            String           @unique @db.VarChar(255)
  passwordHash     String           @map("password_hash") @db.VarChar(255)
  displayName      String           @map("display_name") @db.VarChar(100)
  registrationPath RegistrationPath @map("registration_path")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  avatarConfig           AvatarConfiguration?
  sessions               Session[]
  passwordResetTokens    PasswordResetToken[]
  schoolMemberships      SchoolMember[]
  independentClassrooms  Classroom[]           @relation("IndependentTeacherClassrooms")
  classroomMemberships   ClassroomMembership[]
  createdInvitations     Invitation[]          @relation("InvitationCreator")
  parentOfLinks          ParentLink[]          @relation("ParentLinks")
  childInLinks           ParentLink[]          @relation("ChildLinks")
  usedJoinCodes          JoinCodeUsage[]
  notifications            Notification[]        @relation("NotificationRecipient")
  studentNotifications     Notification[]        @relation("NotificationStudent")
  activityMetrics          ActivityMetric[]
  studentPointTransactions PointTransaction[]    @relation("StudentPointTransactions")
  actorPointTransactions   PointTransaction[]    @relation("ActorPointTransactions")

  @@map("users")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// One row per refresh token ever issued for a session. Only the SHA-256 hex digest
/// is stored. Rotation marks the old row with rotatedAt instead of deleting it, so
/// reuse of a rotated token stays detectable and can revoke the whole session.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(6)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([rotatedAt])
  @@map("refresh_tokens")
}

/// Single-use password reset tokens. Only the SHA-256 hex digest of the opaque token
/// is stored; the raw value exists only in the emailed link. `sourceEventId` ties a
/// row to the outbox event that requested it, so redelivering the event is idempotent,
/// and `sentAt` records that the email went out.
model PasswordResetToken {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  sourceEventId String?   @unique @map("source_event_id") @db.Uuid
  sentAt        DateTime? @map("sent_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model AvatarConfiguration {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @map("user_id") @db.Uuid
  appearance Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("avatar_configurations")
}

model School {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(150)
  slug      String    @unique @db.VarChar(150)
  timeZone  String    @default("America/Argentina/Buenos_Aires") @map("time_zone") @db.VarChar(100)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  members     SchoolMember[]
  classrooms  Classroom[]
  invitations Invitation[]

  @@map("schools")
}

model SchoolMember {
  id        String          @id @default(uuid()) @db.Uuid
  schoolId  String          @map("school_id") @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  role      SchoolRole
  state     MembershipState @default(ACTIVE)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([schoolId, userId])
  @@index([schoolId])
  @@index([userId])
  @@map("school_members")
}

model Classroom {
  id                    String    @id @default(uuid()) @db.Uuid
  schoolId              String?   @map("school_id") @db.Uuid
  independentTeacherId  String?   @map("independent_teacher_id") @db.Uuid
  name                  String    @db.VarChar(120)
  subject               String?   @db.VarChar(200)
  adultMode             Boolean   @default(false) @map("adult_mode")
  chatMuted             Boolean   @default(false) @map("chat_muted")
  collaborationLocked   Boolean   @default(false) @map("collaboration_locked")
  gamesDisabled         Boolean   @default(false) @map("games_disabled")
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  school             School?               @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  independentTeacher User?                 @relation("IndependentTeacherClassrooms", fields: [independentTeacherId], references: [id], onDelete: Restrict)
  memberships        ClassroomMembership[]
  desks              Desk[]
  pet                ClassroomPet?
  invitations        Invitation[]
  parentLinks        ParentLink[]
  notifications      Notification[]
  activityMetrics    ActivityMetric[]
  pointTransactions  PointTransaction[]

  @@index([schoolId])
  @@index([independentTeacherId])
  @@map("classrooms")
}

model ClassroomMembership {
  id          String          @id @default(uuid()) @db.Uuid
  classroomId String          @map("classroom_id") @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  role        ClassroomRole   @default(STUDENT)
  state       MembershipState @default(ACTIVE)
  deletedAt   DateTime?       @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  desk      Desk?

  @@unique([classroomId, userId])
  @@index([classroomId])
  @@index([userId])
  @@map("classroom_memberships")
}

model Desk {
  id           String   @id @default(uuid()) @db.Uuid
  classroomId  String   @map("classroom_id") @db.Uuid
  membershipId String?  @unique @map("membership_id") @db.Uuid
  deskIndex    Int      @map("desk_index")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  classroom  Classroom            @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  membership ClassroomMembership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  @@unique([classroomId, deskIndex])
  @@index([classroomId])
  @@map("desks")
}

model ClassroomPet {
  id          String   @id @default(uuid()) @db.Uuid
  classroomId String   @unique @map("classroom_id") @db.Uuid
  name        String   @db.VarChar(50)
  species     String   @default("cat") @db.VarChar(50)
  level       Int      @default(1)
  experience  Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Restrict)

  @@map("classroom_pets")
}

model ParentLink {
  id          String          @id @default(uuid()) @db.Uuid
  parentId    String          @map("parent_id") @db.Uuid
  childId     String          @map("child_id") @db.Uuid
  classroomId String          @map("classroom_id") @db.Uuid
  state       MembershipState @default(ACTIVE)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent    User      @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Restrict)
  child     User      @relation("ChildLinks", fields: [childId], references: [id], onDelete: Restrict)
  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Restrict)

  @@unique([parentId, childId, classroomId])
  @@index([parentId])
  @@index([childId])
  @@index([classroomId])
  @@map("parent_links")
}

model Invitation {
  id          String          @id @default(uuid()) @db.Uuid
  kind        InvitationKind  @default(EMAIL)
  secretHash  String          @unique @map("secret_hash") @db.VarChar(255)
  targetEmail String?         @map("target_email") @db.VarChar(255)
  schoolId    String?         @map("school_id") @db.Uuid
  classroomId String?         @map("classroom_id") @db.Uuid
  role        InvitationRole  @default(STUDENT)
  maxUses     Int?            @map("max_uses")
  useCount    Int             @default(0) @map("use_count")
  expiresAt   DateTime        @map("expires_at") @db.Timestamptz(6)
  state       InvitationState @default(PENDING)
  createdById String          @map("created_by_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  school    School?         @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  classroom Classroom?      @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  createdBy User            @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  usages    JoinCodeUsage[]

  @@index([schoolId])
  @@index([classroomId])
  @@index([createdById])
  @@index([targetEmail])
  @@map("invitations")
}

/// Aggregated activity signals per user and classroom, one row per UTC day. Connected time is
/// reported by the realtime server as an aggregate (never per tick or per movement) and added to
/// the row of the day the presence session ended. Submissions and participation join this row
/// with the activity-level metric (issue #36).
model ActivityMetric {
  id               String   @id @default(uuid()) @db.Uuid
  classroomId      String   @map("classroom_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  day              DateTime @db.Date
  connectedSeconds Int      @default(0) @map("connected_seconds")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([classroomId, userId, day])
  @@index([userId])
  @@map("activity_metrics")
}

/// Transactional outbox: written in the same transaction as the business change and
/// delivered at-least-once to in-process handlers after commit. Rows are never deleted
/// here; `processedAt` marks delivery and `failedAt` marks exhausted retries.
model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  type        String    @db.VarChar(100)
  payload     Json
  occurredAt  DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  failedAt    DateTime? @map("failed_at") @db.Timestamptz(6)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error") @db.VarChar(300)

  notification Notification?

  @@index([processedAt, failedAt, availableAt])
  @@map("outbox_events")
}

model JoinCodeUsage {
  id           String   @id @default(uuid()) @db.Uuid
  invitationId String   @map("invitation_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  usedAt       DateTime @default(now()) @map("used_at") @db.Timestamptz(6)

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([invitationId, userId])
  @@index([invitationId])
  @@index([userId])
  @@map("join_code_usages")
}

/// Minimal navigation metadata, never source content or grades.
model Notification {
  id            String    @id @default(uuid()) @db.Uuid
  recipientId   String    @map("recipient_id") @db.Uuid
  classroomId   String    @map("classroom_id") @db.Uuid
  studentId     String?   @map("student_id") @db.Uuid
  sourceEventId String    @unique @map("source_event_id") @db.Uuid
  kind          String    @db.VarChar(32)
  resourceId    String    @map("resource_id") @db.Uuid
  readAt        DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  recipient   User                   @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  classroom   Classroom              @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  student     User?                  @relation("NotificationStudent", fields: [studentId], references: [id], onDelete: Restrict)
  sourceEvent OutboxEvent            @relation(fields: [sourceEventId], references: [id], onDelete: Restrict)
  deliveries  NotificationDelivery[]

  @@index([recipientId, createdAt, id])
  @@index([classroomId])
  @@index([studentId])
  @@map("notifications")
}

model NotificationDelivery {
  id             String    @id @default(uuid()) @db.Uuid
  notificationId String    @map("notification_id") @db.Uuid
  channel        String    @db.VarChar(20)
  deliveredAt    DateTime? @map("delivered_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Restrict)

  @@unique([notificationId, channel])
  @@map("notification_deliveries")
}

/// Immutable append-only points ledger per student and classroom.
/// Balance is derived as SUM(amount); entries are never updated or deleted.
model PointTransaction {
  id             String         @id @default(uuid()) @db.Uuid
  classroomId    String         @map("classroom_id") @db.Uuid
  studentId      String         @map("student_id") @db.Uuid
  actorId        String?        @map("actor_id") @db.Uuid
  entryKind      PointEntryKind @map("entry_kind")
  amount         Int
  sourceType     String         @map("source_type") @db.VarChar(40)
  sourceId       String         @map("source_id") @db.Uuid
  idempotencyKey String?        @unique @map("idempotency_key") @db.VarChar(128)
  reason         String         @db.VarChar(240)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  student   User      @relation("StudentPointTransactions", fields: [studentId], references: [id], onDelete: Restrict)
  actor     User?     @relation("ActorPointTransactions", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([classroomId, studentId, createdAt, id])
  @@index([studentId])
  @@map("point_transactions")
}
