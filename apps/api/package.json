{
  "name": "@aula/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "openapi:export": "ts-node -r tsconfig-paths/register src/openapi/export-cli.ts",
    "start:dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aula/contracts": "workspace:*",
    "@nestjs/common": "^11.0.10",
    "@nestjs/core": "^11.0.10",
    "@nestjs/platform-express": "^11.0.10",
    "@nestjs/swagger": "^12.1.0",
    "@scalar/nestjs-api-reference": "^1.2.34",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.10",
    "@swc/core": "^1.16.21",
    "@types/express": "^4.17.25",
    "@types/node": "^22.13.4",
    "@types/supertest": "^6.0.3",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^3.0.5"
  }
}
