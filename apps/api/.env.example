# Copy to .env and replace every placeholder. Never commit real values.
# See the "Configuration" section of the root README for each variable.

NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aula_virtual?schema=public

# Durations: <integer><unit> with unit s, m, h or d.
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=7d
INVITATION_TTL=7d

# Placeholder is intentionally shorter than the 32-character minimum so the API
# refuses to start until it is replaced. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_SERVICE_SECRET=replace-with-generated-secret

# Comma-separated browser origins allowed by CORS (scheme + host [+ port], no path).
ALLOWED_ORIGINS=http://localhost:5173
