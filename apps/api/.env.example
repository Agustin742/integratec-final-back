# Copy to .env and replace every placeholder. Never commit real values.
# See the "Configuration" section of the root README for each variable.

NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aula_virtual?schema=public

# Durations: <integer><unit> with unit s, m, h or d.
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=7d
INVITATION_TTL=7d

JWT_SECRET=
REFRESH_REUSE_GRACE=30s

# Password reset: the emailed link is <PASSWORD_RESET_URL_BASE>?token=<token>.
# The base is required in production; the value below is the local frontend.
PASSWORD_RESET_TTL=1h
PASSWORD_RESET_URL_BASE=http://localhost:5173/reset-password

# Placeholder is intentionally shorter than the 32-character minimum so the API
# refuses to start until it is replaced. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_SERVICE_SECRET=replace-with-generated-secret

# Comma-separated browser origins allowed by CORS (scheme + host [+ port], no path).
ALLOWED_ORIGINS=http://localhost:5173

# Auth data cleanup: rows are pruned this long after they expire (or are rotated/used).
# Must not be shorter than REFRESH_TOKEN_TTL.
AUTH_DATA_RETENTION=30d
AUTH_CLEANUP_INTERVAL=24h
AUTH_CLEANUP_BATCH_SIZE=1000

# Transactional outbox
OUTBOX_POLL_INTERVAL=5s
OUTBOX_MAX_ATTEMPTS=5

# Object storage (local MinIO from docker compose)
S3_BUCKET=aula-virtual-dev
S3_REGION=sa-east-1
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
STORAGE_SIGNED_URL_TTL=5m
