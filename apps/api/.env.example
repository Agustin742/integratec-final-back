# This is the complete updated .env.example template for HU-BOT-003.
# Apply it with (from the repository root):
#   mv apps/api/env.example.proposed.txt apps/api/.env.example
# It is the current develop template plus the Bedrock/daily-question block.

# Copy to .env and replace every placeholder. Never commit real values.
# See the "Configuration" section of the root README for each variable.

NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aula_virtual?schema=public

# Durations: <integer><unit> with unit s, m, h or d.
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=7d
INVITATION_TTL=7d

JWT_SECRET=

# 32-byte AES-256 key (64 hex characters or base64) that seals invitation tokens in the
# outbox so the raw token is never stored in plaintext. Placeholder only; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it makes still-pending invitation emails undeliverable; re-issue those invitations.
INVITATION_TOKEN_KEY=
REFRESH_REUSE_GRACE=30s

# Password reset: the emailed link is <PASSWORD_RESET_URL_BASE>?token=<token>.
# The base is required in production; the value below is the local frontend.
PASSWORD_RESET_TTL=1h
PASSWORD_RESET_URL_BASE=http://localhost:5173/reset-password

# Placeholder is intentionally shorter than the 32-character minimum so the API
# refuses to start until it is replaced. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_SERVICE_SECRET=replace-with-generated-secret

# Comma-separated browser origins allowed by CORS (scheme + host [+ port], no path).
ALLOWED_ORIGINS=http://localhost:5173

# Auth data cleanup: rows are pruned this long after they expire (or are rotated/used).
# Must not be shorter than REFRESH_TOKEN_TTL.
AUTH_DATA_RETENTION=30d
AUTH_CLEANUP_INTERVAL=24h
AUTH_CLEANUP_BATCH_SIZE=1000

# Transactional outbox
OUTBOX_POLL_INTERVAL=5s
OUTBOX_MAX_ATTEMPTS=5

# Realtime server on the private network, called to close the live connections of users who lose
# access. Required in production; the value below is the local realtime server.
REALTIME_INTERNAL_URL=http://localhost:2567

# Object storage (local MinIO from docker compose)
S3_BUCKET=aula-virtual-dev
S3_REGION=sa-east-1
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
STORAGE_SIGNED_URL_TTL=5m

# Shop purchase sliding-window rate limiting
SHOP_PURCHASE_RATE_LIMIT_WINDOW=1m
SHOP_PURCHASE_RATE_LIMIT_MAX=20

# Activity-type grade weights for points conversion (EXAM must be strictly greater than TP)
GRADE_WEIGHT_TP=1
GRADE_WEIGHT_EXAM=1.5

# Equipment change sliding-window rate limiting
EQUIP_RATE_LIMIT_WINDOW=1m
EQUIP_RATE_LIMIT_MAX=20

# Daily review inference (HU-BOT-003). Model and region are configuration values
# (rules/ai-bot-and-daily-briefing.md); the default model offers in-Region on-demand
# inference in us-east-2, available to AWS Free plan accounts. Credentials resolve
# through the SDK default provider chain (the EC2 instance role in production), like S3.
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
BEDROCK_REGION=us-east-2
BEDROCK_INFERENCE_TIMEOUT=15s

# Daily-question answer attempts per user per local day (wrong answers allow retry)
DAILY_QUESTION_MAX_ATTEMPTS=5
