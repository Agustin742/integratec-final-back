{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Returns 200 while the process is up. It does not probe the database.",
        "operationId": "HealthController_getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The API process is alive.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/HealthStatus" } }
            }
          }
        },
        "summary": "Liveness check",
        "tags": ["health"]
      }
    },
    "/auth/register": {
      "post": {
        "description": "Creates a user account, baseline avatar configuration, and the initial organizational structure atomically.",
        "operationId": "AuthController_register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/RegisterRequestDto" } }
          }
        },
        "responses": {
          "201": {
            "description": "Account and organizational structure created successfully.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RegisterResponseDto" }
              }
            }
          },
          "400": {
            "description": "Validation failed or missing required fields (e.g. invalid email, short password).",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          },
          "409": {
            "description": "A user with this normalized email address already exists.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          }
        },
        "summary": "Register account and select organizational path",
        "tags": ["auth"]
      }
    },
    "/auth/login": {
      "post": {
        "description": "Opens a session and returns a short-lived access token (JWT) plus an opaque refresh token. Send the access token in the Authorization header as a Bearer credential.",
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequestDto" } }
          }
        },
        "responses": {
          "200": {
            "description": "Session opened.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TokenPairResponseDto" }
              }
            }
          },
          "400": {
            "description": "Validation failed (malformed email or missing password).",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          },
          "401": {
            "description": "Invalid credentials. The response is identical for an unknown email and a wrong password.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          }
        },
        "summary": "Log in with email and password",
        "tags": ["auth"]
      }
    },
    "/auth/refresh": {
      "post": {
        "description": "Exchanges a refresh token for a new access token and a new refresh token for the same session. The presented refresh token becomes invalid; presenting an already rotated token revokes the whole session, except within a short reuse window after its rotation (REFRESH_REUSE_GRACE, default 30s) where a new pair is issued for the same session. The session keeps its original expiry.",
        "operationId": "AuthController_refresh",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/RefreshRequestDto" } }
          }
        },
        "responses": {
          "200": {
            "description": "New token pair issued.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TokenPairResponseDto" }
              }
            }
          },
          "400": {
            "description": "Validation failed (missing or malformed refreshToken).",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          },
          "401": {
            "description": "Unknown, already rotated, or expired refresh token, or a revoked or expired session. The response is the same generic error in every case.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          }
        },
        "summary": "Rotate the refresh token",
        "tags": ["auth"]
      }
    },
    "/auth/logout": {
      "post": {
        "description": "Revokes the session of the Bearer access token. Afterwards that access token and the session's refresh tokens are rejected with 401.",
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "204": { "description": "Session revoked." },
          "401": {
            "description": "Missing, malformed, expired, or revoked access token.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          }
        },
        "security": [{ "bearer": [] }],
        "summary": "Log out and revoke the current session",
        "tags": ["auth"]
      }
    },
    "/auth/password-reset/request": {
      "post": {
        "description": "Always answers 202 with the same body, whether or not the email belongs to an account, so it cannot be used to discover registered emails. For a registered email a link (`<PASSWORD_RESET_URL_BASE>?token=<token>`) is emailed asynchronously; it is single-use and expires after PASSWORD_RESET_TTL (default 1h). Public endpoint.",
        "operationId": "AuthController_requestPasswordReset",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PasswordResetRequestDto" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Request accepted. Identical for registered and unregistered emails.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PasswordResetRequestedResponseDto" }
              }
            }
          },
          "400": {
            "description": "Validation failed (missing or malformed email).",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          }
        },
        "summary": "Request a password reset email",
        "tags": ["auth"]
      }
    },
    "/auth/password-reset/confirm": {
      "post": {
        "description": "Spends the token from the emailed link: sets the new password and revokes every session of the account, so previous access and refresh tokens stop working. The token works once. Public endpoint.",
        "operationId": "AuthController_confirmPasswordReset",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PasswordResetConfirmRequestDto" }
            }
          }
        },
        "responses": {
          "204": { "description": "Password changed and previous sessions revoked." },
          "400": {
            "description": "Validation failed (missing token, password outside the policy), or the token is unknown, already used or expired (BAD_REQUEST, the same generic error in every case).",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          }
        },
        "summary": "Set a new password with a reset token",
        "tags": ["auth"]
      }
    },
    "/classrooms": {
      "post": {
        "description": "Atomically creates a persistent classroom together with its default classroom pet, initial desk layout, and school teacher membership when applicable. Allowed for independent teachers and school staff (Owner, Admin, Teacher).",
        "operationId": "ClassroomsController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/CreateClassroomDto" } }
          }
        },
        "responses": {
          "201": {
            "description": "Classroom, pet, and initial desks created atomically.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ClassroomDetailResponseDto" }
              }
            }
          },
          "400": {
            "description": "Validation failed (missing or invalid fields).",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          },
          "401": {
            "description": "Missing, malformed, expired, or revoked access token.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          },
          "403": {
            "description": "Caller is a student or parent and is not allowed to create classrooms.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          },
          "404": {
            "description": "Specified school does not exist or is outside the caller scope.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          }
        },
        "security": [{ "bearer": [] }],
        "summary": "Create a virtual classroom",
        "tags": ["classrooms"]
      },
      "get": {
        "description": "Returns a paginated list of classrooms accessible to the authenticated user (as School Owner/Admin, Teacher, enrolled Student, or active linked Parent when adultMode is false).",
        "operationId": "ClassroomsController_list",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "1-based page number.",
            "schema": { "minimum": 1, "maximum": 10000, "default": 1, "type": "integer" }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Maximum number of classrooms returned per page.",
            "schema": { "minimum": 1, "maximum": 100, "default": 20, "type": "integer" }
          },
          {
            "name": "order",
            "required": false,
            "in": "query",
            "description": "Sort direction by classroom creation timestamp (createdAt).",
            "schema": { "default": "desc", "type": "string", "enum": ["asc", "desc"] }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of accessible classrooms.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaginatedClassroomsResponseDto" }
              }
            }
          },
          "400": {
            "description": "Invalid pagination or ordering parameters.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          },
          "401": {
            "description": "Missing, malformed, expired, or revoked access token.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          }
        },
        "security": [{ "bearer": [] }],
        "summary": "List accessible classrooms",
        "tags": ["classrooms"]
      }
    },
    "/classrooms/{id}": {
      "get": {
        "description": "Returns the persistent state of a virtual classroom, its pet, desk count, and the server-derived role and capabilities for the authenticated caller.",
        "operationId": "ClassroomsController_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Classroom UUID",
            "schema": { "example": "4e5f6a7b-0000-4000-8000-000000000002", "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Classroom details and caller capabilities.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ClassroomDetailResponseDto" }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, expired, or revoked access token.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          },
          "404": {
            "description": "Classroom does not exist or caller has no relationship with it.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          }
        },
        "security": [{ "bearer": [] }],
        "summary": "Get classroom details and caller capabilities",
        "tags": ["classrooms"]
      },
      "patch": {
        "description": "Updates classroom name, subject, adultMode, or live control flags (chatMuted, collaborationLocked, gamesDisabled). Restricted to staff of the classroom (School Owner/Admin or the classroom Teacher).",
        "operationId": "ClassroomsController_update",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Classroom UUID",
            "schema": { "example": "4e5f6a7b-0000-4000-8000-000000000002", "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/UpdateClassroomDto" } }
          }
        },
        "responses": {
          "200": {
            "description": "Updated classroom details.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ClassroomDetailResponseDto" }
              }
            }
          },
          "400": {
            "description": "Validation failed (invalid fields or unknown properties).",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          },
          "401": {
            "description": "Missing, malformed, expired, or revoked access token.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          },
          "403": {
            "description": "Caller is a member (student or parent) with insufficient role.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          },
          "404": {
            "description": "Classroom does not exist or caller has no relationship with it.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          }
        },
        "security": [{ "bearer": [] }],
        "summary": "Update classroom configuration and control flags",
        "tags": ["classrooms"]
      }
    },
    "/me/classrooms": {
      "get": {
        "description": "Returns a paginated list of classrooms accessible to the authenticated user (as School Owner/Admin, Teacher, enrolled Student, or active linked Parent when adultMode is false) with derived role and capabilities.",
        "operationId": "MeClassroomsController_listMyClassrooms",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "1-based page number.",
            "schema": { "minimum": 1, "maximum": 10000, "default": 1, "type": "integer" }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Maximum number of classrooms returned per page.",
            "schema": { "minimum": 1, "maximum": 100, "default": 20, "type": "integer" }
          },
          {
            "name": "order",
            "required": false,
            "in": "query",
            "description": "Sort direction by classroom creation timestamp (createdAt).",
            "schema": { "default": "desc", "type": "string", "enum": ["asc", "desc"] }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of accessible classrooms for the current user.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaginatedClassroomsResponseDto" }
              }
            }
          },
          "400": {
            "description": "Invalid pagination or ordering parameters.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          },
          "401": {
            "description": "Missing, malformed, expired, or revoked access token.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          }
        },
        "security": [{ "bearer": [] }],
        "summary": "List classrooms accessible to the authenticated user",
        "tags": ["classrooms"]
      }
    }
  },
  "info": {
    "title": "Aula Virtual API",
    "description": "REST API of Aula Virtual. Every error uses the shared ErrorEnvelope schema; clients branch on error.code.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": { "bearer": { "scheme": "bearer", "bearerFormat": "JWT", "type": "http" } },
    "schemas": {
      "HealthStatus": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["ok", "error"], "example": "ok" },
          "service": { "type": "string", "example": "api" },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2026-01-01T00:00:00.000Z"
          }
        },
        "required": ["status", "service", "timestamp"]
      },
      "RegisterRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "profesora.ana@example.com",
            "description": "User email address, normalized to lowercase and trimmed",
            "maxLength": 255
          },
          "password": {
            "type": "string",
            "example": "passwordSegura123",
            "description": "User password (between 8 characters and 72 UTF-8 bytes)",
            "minLength": 8,
            "maxLength": 72
          },
          "displayName": {
            "type": "string",
            "example": "Prof. Ana García",
            "description": "Display name for the user profile",
            "maxLength": 100
          },
          "path": {
            "type": "string",
            "enum": ["INDEPENDENT_TEACHER", "SCHOOL"],
            "example": "INDEPENDENT_TEACHER",
            "description": "Organizational path chosen during registration"
          },
          "schoolName": {
            "type": "string",
            "example": "Colegio Belgrano Day",
            "description": "School name (required when path is SCHOOL)",
            "maxLength": 150
          }
        },
        "required": ["email", "password", "displayName", "path"]
      },
      "SchoolSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "3f6c2d9e-0000-4000-8000-000000000000",
            "description": "Unique school identifier (UUID)"
          },
          "name": {
            "type": "string",
            "example": "Colegio Belgrano Day",
            "description": "Name of the created school"
          },
          "slug": {
            "type": "string",
            "example": "colegio-belgrano-day",
            "description": "Unique slug generated for the school"
          },
          "timeZone": {
            "type": "string",
            "example": "America/Argentina/Buenos_Aires",
            "description": "IANA time zone for the school"
          }
        },
        "required": ["id", "name", "slug", "timeZone"]
      },
      "RegisterResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "3f6c2d9e-0000-4000-8000-000000000000",
            "description": "Unique user identifier (UUID)"
          },
          "email": {
            "type": "string",
            "example": "profesora.ana@example.com",
            "description": "Registered user email address"
          },
          "displayName": {
            "type": "string",
            "example": "Prof. Ana García",
            "description": "User display name"
          },
          "path": {
            "type": "string",
            "enum": ["INDEPENDENT_TEACHER", "SCHOOL"],
            "example": "INDEPENDENT_TEACHER",
            "description": "Organizational path chosen during registration"
          },
          "school": {
            "description": "Created school details if path is SCHOOL",
            "allOf": [{ "$ref": "#/components/schemas/SchoolSummaryDto" }]
          },
          "createdAt": {
            "type": "string",
            "example": "2026-11-05T20:00:00.000Z",
            "description": "Account creation instant in UTC (ISO 8601)"
          }
        },
        "required": ["id", "email", "displayName", "path", "createdAt"]
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "VALIDATION_FAILED",
          "BAD_REQUEST",
          "UNAUTHENTICATED",
          "FORBIDDEN",
          "NOT_FOUND",
          "CONFLICT",
          "TOO_MANY_REQUESTS",
          "SERVICE_UNAVAILABLE",
          "INTERNAL_ERROR"
        ],
        "description": "Stable machine-readable code. Clients branch on this, never on the message."
      },
      "ErrorDetail": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "example": "address.city",
            "description": "Dotted path of the invalid field."
          },
          "messages": {
            "example": ["city must be longer than or equal to 3 characters"],
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["field", "messages"]
      },
      "ErrorBody": {
        "type": "object",
        "properties": {
          "code": {
            "example": "VALIDATION_FAILED",
            "description": "Stable machine-readable code. Clients branch on this, never on the message.",
            "allOf": [{ "$ref": "#/components/schemas/ErrorCode" }]
          },
          "message": { "type": "string", "example": "Validation failed" },
          "details": {
            "description": "Per-field problems, when applicable.",
            "type": "array",
            "items": { "$ref": "#/components/schemas/ErrorDetail" }
          },
          "correlationId": {
            "type": "string",
            "example": "3f2b8c1e-0d1a-4f4e-9a55-6f0c2f9c1a11",
            "description": "Echoes the x-request-id header; quote it when reporting a problem."
          }
        },
        "required": ["code", "message", "correlationId"]
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": { "error": { "$ref": "#/components/schemas/ErrorBody" } },
        "required": ["error"]
      },
      "LoginRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "profesora.ana@example.com",
            "description": "Account email address, normalized to lowercase and trimmed",
            "maxLength": 255
          },
          "password": {
            "type": "string",
            "example": "passwordSegura123",
            "description": "Account password (at most 72 UTF-8 bytes, the bcrypt input limit)",
            "maxLength": 72
          }
        },
        "required": ["email", "password"]
      },
      "TokenPairResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIuLi4ifQ.signature",
            "description": "Short-lived JWT (HS256). Send it as `Authorization: Bearer <accessToken>`."
          },
          "refreshToken": {
            "type": "string",
            "example": "q3VZk0mH1xk4oQe2l7Yw5r8m9uJcT6bNf0aXsD1pLhE",
            "description": "Opaque refresh token. Stored server-side only as a SHA-256 digest; keep it secret."
          },
          "tokenType": {
            "type": "string",
            "example": "Bearer",
            "enum": ["Bearer"],
            "description": "Authorization scheme."
          },
          "expiresIn": {
            "type": "number",
            "example": 900,
            "description": "Access token lifetime in seconds."
          }
        },
        "required": ["accessToken", "refreshToken", "tokenType", "expiresIn"]
      },
      "RefreshRequestDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "example": "q3VZk0mH1xk4oQe2l7Yw5r8m9uJcT6bNf0aXsD1pLhE",
            "description": "The current opaque refresh token. It is single-use: the response carries its replacement.",
            "maxLength": 512
          }
        },
        "required": ["refreshToken"]
      },
      "PasswordResetRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "profesora.ana@example.com",
            "description": "Email of the account to reset, normalized to lowercase and trimmed",
            "maxLength": 255
          }
        },
        "required": ["email"]
      },
      "PasswordResetRequestedResponseDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "If the email belongs to an account, a reset link has been sent.",
            "description": "Constant message; it never reveals whether the email is registered."
          }
        },
        "required": ["message"]
      },
      "PasswordResetConfirmRequestDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "example": "q3VZk0mH1xk4oQe2l7Yw5r8m9uJcT6bNf0aXsD1pLhE",
            "description": "The opaque token from the emailed link (`?token=`). It works once.",
            "maxLength": 512
          },
          "newPassword": {
            "type": "string",
            "example": "passwordSegura123",
            "description": "The new password, under the same policy as registration",
            "minLength": 8,
            "maxLength": 72
          }
        },
        "required": ["token", "newPassword"]
      },
      "CreateClassroomDto": {
